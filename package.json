{
  "name": "prism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A C and C++ compiler to JavaScript, written in plain JavaScript, that compiles the unmodified source of DOS-era and early-Linux games and emulators and runs them in the browser.",
  "scripts": {
    "oracle:build": "docker build --platform linux/386 -t prism-oracle tools/oracle",
    "oracle:version": "node -e \"import('./tools/oracle.mjs').then(o=>console.log(o.version()))\"",
    "probe:abi": "node tools/probe-abi.mjs",
    "gate:abi": "node tools/gate-abi.mjs",
    "gate:cpp": "node tools/gate-cpp.mjs",
    "gate:deep": "node tools/gate-abi.mjs 3000 20260820 && CPP_GEN=250 node tools/gate-cpp.mjs && DECL_GEN=200 node tools/gate-decl.mjs && node tools/gate-run.mjs",
    "test": "node tools/gate-abi.mjs && node tools/gate-cpp.mjs && node tools/gate-decl.mjs && node tools/gate-run.mjs && node tools/gate-suite.mjs",
    "gate:decl": "node tools/gate-decl.mjs",
    "gate:run": "node tools/gate-run.mjs",
    "gate:suite": "node tools/gate-suite.mjs",
    "gate:suite:capture": "node tools/gate-suite.mjs --capture",
    "gaps": "node tools/gate-suite.mjs --gaps",
    "gate:torture": "node tools/gate-suite.mjs --suite=torture",
    "gaps:torture": "node tools/gate-suite.mjs --suite=torture --gaps",
    "bench": "node tools/bench.mjs --steps=20000000",
    "mame": "node tools/mame.mjs",
    "mamediff": "node tools/mamediff.mjs",
    "z80diff": "node tools/z80diff.mjs",
    "gates": "node tools/gates.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "compiler",
    "c",
    "c++",
    "javascript",
    "dos",
    "retrocomputing",
    "webgl",
    "emulation",
    "games"
  ],
  "license": "MIT",
  "author": "Julien Frelat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrelat-lab/prism.git"
  },
  "homepage": "https://github.com/jfrelat-lab/prism",
  "bugs": {
    "url": "https://github.com/jfrelat-lab/prism/issues"
  }
}
