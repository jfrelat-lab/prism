    "../jpeg-6b-generated",
    "../jpeg-6b",
    "../zlib-1.1.3"
  ],
  "defines": {
    "__linux__": "1",
    "NDEBUG": "1",
    "CONFIG_USER": "\".neverball\"",
    "CONFIG_DATA": "\"./data\"",
    "CONFIG_LOCALE": "\"./locale\"",
    "ENABLE_NLS": "0",
