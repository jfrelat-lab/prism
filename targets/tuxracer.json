    "tcl8.4.20/unix"
  ],
  "_defines": "Two configures' answers in one table. Tcl's are what its unix/configure finds (run in the oracle container for the list), less what PRISM's libc is not: no 64-bit file API, no tm_zone/tm_gmtoff, no fts, no langinfo. Tux Racer's choose GLUT: without SDL there is no sound and no joystick, which its own #ifdefs allow.",
  "defines": {
    "HAVE_LIMITS_H": "1",
    "HAVE_UNISTD_H": "1",
    "HAVE_SYS_PARAM_H": "1",
    "STATIC_BUILD": "1",
    "HAVE_CAST_TO_UNION": "1",
    "NDEBUG": "1",
    "HAVE_GETCWD": "1",
    "HAVE_OPENDIR": "1",
    "HAVE_STRSTR": "1",
    "HAVE_STRTOL": "1",
    "HAVE_STRTOLL": "1",
    "HAVE_STRTOULL": "1",
    "HAVE_TMPNAM": "1",
    "HAVE_WAITPID": "1",
    "USE_TERMIOS": "1",
    "HAVE_SYS_TIME_H": "1",
    "TIME_WITH_SYS_TIME": "1",
    "HAVE_GMTIME_R": "1",
    "HAVE_LOCALTIME_R": "1",
    "HAVE_ST_BLKSIZE": "1",
    "STDC_HEADERS": "1",
    "NO_UNION_WAIT": "1",
    "HAVE_SIGNED_CHAR": "1",
    "HAVE_SYS_IOCTL_H": "1",
    "TCL_WIDE_INT_TYPE": "long long",
    "TCL_LIBRARY": "\"/usr/lib/tcl8.4\"",
    "TCL_PACKAGE_PATH": "\"/usr/lib\"",
    "TCL_SHLIB_EXT": "\"\"",
    "__linux__": "1",
    "VERSION": "\"0.61\"",
    "PACKAGE": "\"tuxracer\"",
    "TCL_HEADER": "<tcl.h>",
    "HAVE_GLUT": "1",
    "HAVE_GETTIMEOFDAY": "1",
    "HAVE_STRDUP": "1",
    "HAVE_ISNAN": "1",
    "HAVE_FINITE": "1",
    "HAVE_GL_GLEXT_H": "1",
    "DATA_DIR": "\"/tuxracer-data-0.61\""
  },
