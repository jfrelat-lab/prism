  "_units": "What configure selects for this build: the MODULES of Makefile.common (base, common, gui, sound, backends) and the Sky engine's module.mk, each module's MODULE_OBJS, and the SDL backend's OBJS (backends/sdl/build.rules). The other engines are disabled as configure disables them, with DISABLE_*.",
  "include": [
    ".",
    "common",
    "../scummvm-0.6.1-generated"
  ],
  "_include": "Makefile's -I$(srcdir) -I$(srcdir)/common, and config.h, written by the release's configure (tools/scummvm-configure.mjs).",
  "defines": {
    "HAVE_CONFIG_H": "1",
    "UNIX": "1",
    "DISABLE_SCUMM": "1",
    "DISABLE_SIMON": "1",
    "DISABLE_SWORD1": "1",
    "DISABLE_SWORD2": "1",
    "DISABLE_QUEEN": "1",
    "_GNU_SOURCE": "1",
    "_REENTRANT": "1"
  },
  "_defines": "Makefile's -DHAVE_CONFIG_H, build.rules' -DUNIX, configure's DISABLE_* for the engines left out, and what sdl-config --cflags adds.",
  "compile": {
    "cxx": {
      "std": "c++98"
    },
    "memory": 128,
    "collect": true
  },
  "_compile": "configure gives gcc 3 -ansi: C++98.",
  "env": [
    "stdio",
    "environ",
    "sdl12"
  ],
  "host": "sdl"
}
